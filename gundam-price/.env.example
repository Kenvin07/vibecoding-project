# ===========================================================================
# .env.example ｜ 环境变量模板（Day 23 新增）
# ===========================================================================
# 【这个文件是什么】
#   一张「菜谱」：告诉你这个项目需要配哪几个环境变量、各自是干什么用的。
#
# 【为什么可以进 Git 仓库】
#   因为它里面**一个真值都没有** —— 所有值都是占位说明文字。
#   真正的值写在 .env 或云平台配置里，而 .env 被 .gitignore 挡在仓库外面。
#   这样队友能照着模板配环境，但谁也拿不到你的密钥。
#
# 【怎么用】
#   复制一份改名为 .env，把每行的等号后面换成自己的真值：
#     cp .env.example .env
#   注意：.env 千万不能被提交（.gitignore 已处理，但每次提交前仍建议看一眼）。
#
# 【本项目的实际部署方式：不走 .env 文件】
#   这个项目的后端是腾讯云 CloudBase 的 HTTP 云函数，
#   环境变量是在**云开发控制台**里配的，不是靠 .env 文件喂进去：
#     控制台 → 云函数 → api → 函数配置 → 环境变量 → 新增
#   本文件的作用是**登记「需要哪些变量」**，作为配置清单和交接文档使用。
#   （本地用 node index.js 自测时，可以临时建 .env 或直接 export。）
# ===========================================================================

# ---------------------------------------------------------------------------
# 一、数据库访问（数据网关的身份）
# ---------------------------------------------------------------------------
# 云开发环境 ID，形如 gundam-market-xxxxxxxx
# 从哪找：CloudBase 控制台 → 环境 → 环境 ID
CLOUDBASE_ENV_ID=

# 【敏感】云开发 API Key（服务端专用，等于管理员身份）
# 从哪找：CloudBase 控制台 → 环境管理 → API 密钥 → 新建「API Key」
# 警告：绝不进代码、不进 Git、不截图、不粘进聊天记录
CLOUDBASE_API_KEY=

# ---------------------------------------------------------------------------
# 二、写接口鉴权（Day 18 新增）
# ---------------------------------------------------------------------------
# 【敏感】写接口密钥。前端发 POST / PATCH / DELETE 时，
# 必须在请求头带上 X-API-KEY，值要与这一条完全相等，否则返回 401。
# 怎么生成：自己定一个够长的随机串（建议 32 位十六进制）
# 读接口（GET）不需要它，保持匿名可访问。
WRITE_API_KEY=

# ---------------------------------------------------------------------------
# 三、运行参数（非敏感，有默认值）
# ---------------------------------------------------------------------------
# 服务监听端口。云函数固定 9000（要和控制台「监听端口」配置一致）；
# 本机自测时可用 9100 换个口，避免和其他程序打架。
# 不填则默认 9000。
PORT=9000
